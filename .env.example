# 默认无需复制此文件即可启动。自定义端口时同时修改PUBLIC_ORIGIN。
HTTP_PORT=8088
PUBLIC_ORIGIN=http://localhost:8088
BIND_ADDRESS=127.0.0.1
# 公网部署必须使用HTTPS，并配置外部TLS反向代理。
# PUBLIC_ORIGIN=https://ios.example.com
# 仅信任你自己的反向代理地址，默认不信任外部X-Forwarded-For。
REAL_IP_TRUSTED_CIDR=127.0.0.1/32
MIN_FREE_GB=8
# 不要在这里写Apple ID、密码、验证码或Apple令牌。
