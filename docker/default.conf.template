limit_req_zone $binary_remote_addr zone=api_rate:1m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=api_connections:1m;
server {
    listen 8080;
    server_name _;
    set_real_ip_from ${REAL_IP_TRUSTED_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    client_max_body_size 16k;
    client_body_buffer_size 32k;
    client_body_timeout 15s;
    location / {
        proxy_pass http://app:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_buffering off;
        proxy_request_buffering on;
    }
    location /api/ {
        limit_req zone=api_rate burst=20 nodelay;
        limit_req_status 429;
        limit_conn api_connections 8;
        limit_conn_status 429;
        limit_rate 4m;
        proxy_pass http://app:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_buffering off;
        proxy_request_buffering on;
    }
}
